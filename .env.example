# Copy this file to .env and fill in COURSE_ID.
# Never put your Moodle password here: you log in yourself in the browser.

# Moodle site root, including the /moodle part, no trailing slash
MOODLE_URL=https://haigmoodle.haigazian.edu.lb/moodle

# The number after ?id= in the course address: /course/view.php?id=1234, IST huwe 959
COURSE_ID=
